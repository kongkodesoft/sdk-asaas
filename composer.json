{
  "name": "kongkodesoft/asaas-sdk",
  "type": "library",
  "description": "SDK PHP para a API v3 do Asaas.com, focado em recorrência (cartão e Pix Automático) e pagamentos instantâneos (Pix e cartão). Seguro para coroutines Swoole.",
  "keywords": ["Asaas", "API", "Pix", "Pix Automático", "Credit Card", "Subscription", "Swoole"],
  "homepage": "https://github.com/kongkodesoft/asaas-sdk",
  "license": "BSD-2-Clause",
  "authors": [
    {
      "name": "Guilherme Trevisan",
      "email": "havennow@gmail.com"
    }
  ],
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "guzzlehttp/guzzle": "^7.9",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "suggest": {
    "guzzlehttp/guzzle": "Cliente PSR-18 + fábricas PSR-17 (use com SWOOLE_HOOK_ALL em Swoole)."
  },
  "autoload": {
    "psr-4": {
      "Kongkodesoft\\Asaas\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kongkodesoft\\Asaas\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --exclude-group sandbox",
    "test:sandbox": "phpunit --group sandbox",
    "stan": "phpstan analyse --memory-limit=512M",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "check": ["@cs", "@stan", "@test"]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
